{
  "ConnectionStrings": {
    "SurveillanceCamerasDb": "Server=Localhost;Port=5432;Database=SurveillanceCamerasDb;Username=postgres;Password=admin123;"
  },
  "Jwt": {
    "Issuer": "SurveillanceCameras.Web",
    "Audience": "SurveillanceCameras.Client",
    "SigningKey": "CHANGE_ME_TO_A_LONG_RANDOM_SECRET_KEY",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 7
  },
  "AccountSession": {
    "ProfileDirectory": "data/browser-profiles/tiktok",
    "Headless": false,
    "Channel": "chrome",
    "PollIntervalSeconds": 30,
    "DebounceSeconds": 3
  },
  "CrawlStory": {
    "DefaultIntervalMs": 0,
    "HostIntervalsMs": {
      "wikicv.org": 3000
    },
    "HostRequestsPerMinute": {
      "wikicv.org": 5
    },
    "BlockedCooldownSeconds": 600
  },
  "TytUpload": {
    "Enabled": true,
    "ScheduleIntervalSeconds": 60,
    "DelayBetweenChaptersSeconds": 8,
    "ImmediateBatchSize": 20,
    "TimeZone": "Asia/Ho_Chi_Minh"
  },
  "FailureRecovery": {
    "Enabled": true,
    "IntervalMinutes": 10,
    "MaxPerGroup": 50,
    "RequeueAfterMinutes": 60
  },
  "TikTokApi": {
    "BaseUrl": "https://www.tiktok.com",
    "Language": "vi-VN",
    "Region": "VN",
    "TimeoutSeconds": 30,
    "BrowserChannel": "chrome",
    "MaxConcurrentBrowserPages": 2
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "App": {
    "FreeEpisodes": 6,
    "AdEpisodes": 3,
    "PrivacyUrl": null,
    "TermsUrl": null
  },
  "SocialAuth": {
    "Google": {
      "ClientIds": []
    },
    "Apple": {
      "ClientIds": []
    },
    "AndroidRedirectScheme": "luma-auth"
  },
  "Store": {
    "AppStore": {
      "BundleId": "com.aica.movie",
      "AllowSandbox": true
    },
    "GooglePlay": {
      "PackageName": "com.mte.movie.movieai",
      "ServiceAccountJson": "",
      "NotificationToken": ""
    }
  },
  "MovieDailySync": {
    "Enabled": true,
    "TimeOfDay": "03:00",
    "DelayBetweenDramasSeconds": 3
  },
  "EpisodeVideoStore": {
    "Enabled": true,
    "IntervalSeconds": 60,
    "BatchSize": 5,
    "DelayBetweenVideosSeconds": 2,
    "MaxAttempts": 3,
    "BlockedBackoffMinutes": 30,
    "MaxVideoBytes": 524288000
  }
