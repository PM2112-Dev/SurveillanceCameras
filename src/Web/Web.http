# For more info on HTTP files go to https://aka.ms/vs/httpfile
@Web_HostAddress = https://localhost:7210
@Email = administrator@localhost
@Password = Administrator1!
@AccessToken = <AccessToken>
@RefreshToken = <RefreshToken>

# POST Register (optional)
POST {{Web_HostAddress}}/api/Users/register
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

# POST Login
# Copy accessToken and refreshToken from response into @AccessToken / @RefreshToken.
POST {{Web_HostAddress}}/api/Users/login
Content-Type: application/json

{
  "email": "{{Email}}",
  "password": "{{Password}}"
}

###

# POST Refresh
# Use when access token expires; rotate both tokens from response.
POST {{Web_HostAddress}}/api/Users/refresh
Content-Type: application/json

{
  "refreshToken": "{{RefreshToken}}"
}

###

# GET WebSources (list, filter + paging)
GET {{Web_HostAddress}}/api/WebSources?title=&page=1&pageSize=20
Authorization: Bearer {{AccessToken}}

###

# POST WebSources
POST {{Web_HostAddress}}/api/WebSources
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "title": "Wikidich",
  "baseUrl": "https://wikidich.com"
}

###

# GET StorySources (list, filter theo WebSource / tên)
GET {{Web_HostAddress}}/api/StorySources?webSourceId=&title=&page=1&pageSize=20
Authorization: Bearer {{AccessToken}}

###

# GET Categories (list)
GET {{Web_HostAddress}}/api/Categories?title=&page=1&pageSize=20
Authorization: Bearer {{AccessToken}}

###

# POST Categories
POST {{Web_HostAddress}}/api/Categories
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{
  "title": "Tiên hiệp"
}

###

# POST Logout
POST {{Web_HostAddress}}/api/Users/logout
Authorization: Bearer {{AccessToken}}
Content-Type: application/json

{}

###