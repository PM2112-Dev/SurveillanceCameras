# Copy thành file .env ở thư mục gốc (cùng chỗ docker-compose.yml) rồi đổi giá trị.
POSTGRES_PASSWORD=doi-mat-khau-db
# Chuỗi ngẫu nhiên dài ≥ 32 ký tự (vd. openssl rand -base64 48)
JWT_SIGNING_KEY=doi-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
# Mật khẩu xem màn hình Chrome qua noVNC (cổng 6080)
VNC_PASSWORD=doi-mat-khau-vnc
WEB_PORT=8080
NOVNC_PORT=6080
TZ=Asia/Ho_Chi_Minh

# [Test] Ngrok (chạy bằng: docker compose --profile ngrok up -d)
NGROK_AUTHTOKEN=
NGROK_DOMAIN=headscarf-lard-broken.ngrok-free.dev

# [Production] Cloudflare Tunnel (chạy bằng: docker compose --profile cloudflare up -d)
# Lấy token tại Cloudflare Zero Trust → Networks → Tunnels (trỏ Public Hostname về http://web:8080)
CLOUDFLARE_TUNNEL_TOKEN=
